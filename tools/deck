#!/bin/sh
# CYBERDECK A9 v0.2 - BusyBox + native ARM64 network/security toolbox.
# Runs from RAM. Read-only commands except explicitly requested PCAP captures.
PATH="/opt/cyberdeck/bin:/bin:/sbin:/usr/bin:/usr/sbin"
export PATH
PROBE="/opt/cyberdeck/bin/cyberprobe"
usage() {
cat <<'HELP'
   ____  _  _  ____  ____  ____  ____  ____  _  _
  / ___)( \/ )(  _ \(  __)(  _ \(    \(  __)/ )( \
  \___ \ )  /  ) _ ( ) _)  )   / ) D ( ) _) ) \/ (
  (____/(__/  (____/(____)(__\_)(____/(____)\____/
        A9 // LINUX ARM64 // CYBERSEC TOOLKIT 0.2

  deck info              Device, CPU, RAM, kernel, display
  deck net               Interfaces, routes, neighbors, sockets
  deck ping <IP>         ICMP reachability
  deck trace <IP>        Trace route (BusyBox)
  deck dns <name>        Lookup DNS records
  deck scan <IP> [ports] TCP connect scan, e.g. 22,80,443,8080
  deck banner <IP> <p>   Read initial service banner
  deck http <IP> <p>     Cleartext HTTP headers
  deck capture <n> <s>   Save PCAP on usb0 in RAM (/tmp)
  deck hash <file>       SHA256 local file
  deck log               Kernel and ramdisk boot logs
  deck shell             Interactive BusyBox ash (USB console)
  deck terminal          Mirror shell to iPhone LCD + Dell (USB keyboard)
  deck gui               Restore CYBERDECK GUI framebuffer
  deck menu              Interactive text menu
  deck help              This help
Network testing only with permission. USB0 is currently the
only operational data interface. No Wi-Fi/touchscreen driver yet.
HELP
}
info() {
  printf '\n== HARDWARE / SOFTWARE ==\n'
  uname -a
  echo '-- CPU --'
  grep '^processor' /proc/cpuinfo
  echo '-- RAM --'
  grep -E '^MemTotal:|^MemAvailable:|^MemFree:' /proc/meminfo
  echo '-- FRAMEBUFFER --'
  cat /sys/class/graphics/fb0/virtual_size /sys/class/graphics/fb0/bits_per_pixel 2>/dev/null
  echo '-- ROOT / BLOCK --'
  mount | grep '^rootfs '
  cat /proc/partitions
}
network() {
  echo '== IP ADDRESSES =='
  ip addr show
  echo '== ROUTES =='
  ip route show
  echo '== ARP / NEIGHBORS =='
  ip neigh show
  echo '== SOCKETS =='
  netstat -tuln
}
logs() {
  echo '== HOOL0CK INIT =='
  cat /HL_init.log
  echo '== LAST KERNEL MESSAGES =='
  dmesg | tail -n 40
}
gui() {
  if [ -r /tmp/cyberdeck_frame_v01.bgrx ]; then
    dd if=/tmp/cyberdeck_frame_v01.bgrx of=/dev/fb0 bs=3000 count=1334 2>/dev/null
    echo 'CYBERDECK framebuffer restored.'
  else
    echo 'RAM framebuffer image unavailable.'
    return 1
  fi
}
terminal() {
  [ -w /dev/tty0 ] || { echo 'Framebuffer console not available'; return 1; }
  printf '\033[2J\033[H' > /dev/tty0
  printf 'CYBERDECK A9  //  ARM64 INTERACTIVE TERMINAL\nUSB KEYBOARD: DELL XPS  |  TYPE deck help\n\n' > /dev/tty0
  echo 'Terminal mirrored on iPhone and Dell. Type exit to return to the GUI.'
  # The shell receives input from USB Telnet and sends output to both endpoints.
  PS1='CYBERDECK-A9# ' /bin/sh -i 2>&1 | tee /dev/tty0
  gui
}
menu() {
  while :; do
    printf '\n[CYBERDECK A9] 1:INFO 2:NET 3:LOG 4:PING 5:SCAN 6:SHELL 0:EXIT\n> '
    read -r choice || return 0
    case "$choice" in
      1) info ;; 2) network ;; 3) logs ;;
      4) printf 'Target IP: '; read -r target; ping -c 3 -W 2 "$target" ;;
      5) printf 'Authorized target IPv4: '; read -r target
         "$PROBE" scan "$target" ;;
      6) echo 'Return with exit'; /bin/sh ;;
      0) return 0 ;;
      *) echo 'Unknown selection' ;;
    esac
  done
}
case "${1:-help}" in
  info) info ;;
  net) network ;;
  ping) shift; [ "$#" -eq 1 ] || { usage; exit 2; }; ping -c 3 -W 2 "$1" ;;
  trace) shift; [ "$#" -eq 1 ] || { usage; exit 2; }; traceroute -m 12 -w 2 "$1" ;;
  dns) shift; [ "$#" -eq 1 ] || { usage; exit 2; }; nslookup "$1" ;;
  scan) shift; "$PROBE" scan "$@" ;;
  banner) shift; "$PROBE" banner "$@" ;;
  http) shift; "$PROBE" http "$@" ;;
  capture)
    shift
    [ "$#" -eq 2 ] || { usage; exit 2; }
    "$PROBE" capture usb0 "$1" "$2" /tmp/cyberdeck_capture.pcap ;;
  hash) shift; [ "$#" -eq 1 ] || { usage; exit 2; }; sha256sum "$1" ;;
  log) logs ;;
  shell) echo 'CYBERDECK root shell. exit to return.'; exec /bin/sh ;;
  terminal) terminal ;;
  gui) gui ;;
  menu) menu ;;
  help|--help|-h) usage ;;
  *) echo "Unknown command: $1"; usage; exit 2 ;;
esac
