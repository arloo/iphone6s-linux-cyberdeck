@@ -881,7 +881,7 @@ static int apple_z2_boot_hbpp(struct apple_z2 *z2)
 	/* Clock out ATN/NOPs while in reset so SCK idles high (mode 3) */
 	error = apple_z2_hbpp_probe(z2, NULL);
 	if (error)
-		return error;
+		goto err_power_off;
 
 	gpiod_set_value(z2->reset_gpio, 0);
 	msleep(z2->variant->reset_delay_ms);
@@ -891,12 +891,14 @@ static int apple_z2_boot_hbpp(struct apple_z2 *z2)
 		error = -ENODEV;
 	if (!error)
 		error = apple_z2_upload_firmware(z2);
-	if (error) {
-		if (z2->booted)
-			disable_irq(z2->spidev->irq);
-		z2->booted = false;
-		apple_z2_power_off(z2);
-	}
+	if (!error)
+		return 0;
+
+err_power_off:
+	if (z2->booted)
+		disable_irq(z2->spidev->irq);
+	z2->booted = false;
+	apple_z2_power_off(z2);
 	return error;
 }
 
