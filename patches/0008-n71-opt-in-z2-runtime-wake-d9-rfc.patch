+/*
+ * N71/S8000 experimental runtime bring-up.
+ *
+ * Corellium hx-touchd uses 16-byte commands whose LE checksum sums the
+ * first 14 bytes. Its sequence is 0xEE wake, then E3/D9 report discovery.
+ * These controls are NOT called from probe: a single root-only sysfs write
+ * triggers exactly one 16-byte SPI transaction. There is no retry.
+ *
+ * The source precedent is for other Z2 devices and is NOT an N71 validation.
+ */
+static bool apple_z2_n71_runtime_ready(struct apple_z2 *z2)
+{
+	return z2 && z2->variant && z2->variant->hbpp &&
+	       of_machine_is_compatible("apple,n71") &&
+	       READ_ONCE(z2->booted);
+}
+
+/* Must hold report_lock: tx/rx buffers are shared with the IRQ handler. */
+static int apple_z2_n71_runtime_cmd(struct apple_z2 *z2,
+				   u8 opcode, u8 report,
+				   u8 *response, bool *checksum_ok)
+{
+	struct spi_transfer transfer = {
+		.tx_buf = z2->tx_buf,
+		.rx_buf = z2->rx_buf,
+		.len = 16,
+	};
+	unsigned int sum = opcode + report;
+	unsigned int reply_sum = 0;
+	unsigned int i;
+	int err;
+
+	memset(z2->tx_buf, 0, 16);
+	memset(z2->rx_buf, 0, 16);
+	z2->tx_buf[0] = opcode;
+	z2->tx_buf[1] = report;
+	put_unaligned_le16(sum, z2->tx_buf + 14);
+	err = spi_sync_transfer(z2->spidev, &transfer, 1);
+	if (err)
+		return err;
+	for (i = 0; i < 14; i++)
+		reply_sum += z2->rx_buf[i];
+	*checksum_ok = (u16)reply_sum ==
+		get_unaligned_le16(z2->rx_buf + 14);
+	*response = z2->rx_buf[0];
+	return 0;
+}
+
+static ssize_t runtime_wake_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	int err;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!apple_z2_n71_runtime_ready(z2))
+		return -EOPNOTSUPP;
+	mutex_lock(&z2->report_lock);
+	if (z2->n71_wake_attempted) {
+		err = -EALREADY;
+		goto unlock;
+	}
+	/* Arm the one-shot gate before sending, even if transport errors. */
+	z2->n71_wake_attempted = true;
+	z2->n71_wake_rc = apple_z2_n71_runtime_cmd(z2,
+		APPLE_Z2_CMD_RUNTIME_WAKE, 0,
+		&z2->n71_wake_reply, &z2->n71_wake_checksum_ok);
+	err = z2->n71_wake_rc;
+unlock:
+	mutex_unlock(&z2->report_lock);
+	return err ? err : count;
+}
+
+static ssize_t runtime_d9_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	int err;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!apple_z2_n71_runtime_ready(z2))
+		return -EOPNOTSUPP;
+	mutex_lock(&z2->report_lock);
+	if (!z2->n71_wake_attempted || z2->n71_wake_rc) {
+		err = -EAGAIN;
+		goto unlock;
+	}
+	if (z2->n71_d9_attempts >= 2) {
+		err = -EALREADY;
+		goto unlock;
+	}
+	/* hx-touchd issues two E3/D9 commands; expose them one at a time. */
+	z2->n71_d9_attempts++;
+	z2->n71_d9_rc = apple_z2_n71_runtime_cmd(z2,
+		APPLE_Z2_CMD_RUNTIME_REPORT_INFO, APPLE_Z2_REPORT_SURFACE,
+		&z2->n71_d9_reply, &z2->n71_d9_checksum_ok);
+	err = z2->n71_d9_rc;
+	if (!err) {
+		z2->n71_d9_status = z2->rx_buf[2];
+		z2->n71_d9_size = get_unaligned_le16(z2->rx_buf + 3);
+	}
+unlock:
+	mutex_unlock(&z2->report_lock);
+	return err ? err : count;
+}
+
+/* State query has NO SPI side effects. No raw firmware/report bytes. */
+static ssize_t runtime_state_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	ssize_t len;
+
+	if (!z2 || !z2->variant || !z2->variant->hbpp ||
+	    !of_machine_is_compatible("apple,n71"))
+		return -EOPNOTSUPP;
+	mutex_lock(&z2->report_lock);
+	len = sysfs_emit(buf,
+		"booted=%u wake_attempted=%u wake_rc=%d wake_reply=0x%02x "
+		"wake_checksum_ok=%u d9_attempts=%u d9_rc=%d "
+		"d9_reply=0x%02x d9_status=%u d9_size=%u d9_checksum_ok=%u\n",
+		z2->booted, z2->n71_wake_attempted,
+		z2->n71_wake_rc, z2->n71_wake_reply,
+		z2->n71_wake_checksum_ok, z2->n71_d9_attempts,
+		z2->n71_d9_rc, z2->n71_d9_reply,
+		z2->n71_d9_status, z2->n71_d9_size,
+		z2->n71_d9_checksum_ok);
+	mutex_unlock(&z2->report_lock);
+	return len;
+}
