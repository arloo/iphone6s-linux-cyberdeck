+/*
+ * N71-only, one-shot manual D9 descriptor read.
+ * Corellium's type-1 and type-2 long reads have different 21-byte frames;
+ * there is no independent N71 type match, so the operator must select it.
+ * NEVER automatically retry another mode.
+ */
+static int apple_z2_n71_fetch_d9(struct apple_z2 *z2, u8 mode)
+{
+	struct spi_transfer xfer = {
+		.tx_buf = z2->tx_buf,
+		.rx_buf = z2->rx_buf,
+	};
+	unsigned int sum = 0;
+	unsigned int i;
+	u8 descriptor[APPLE_Z2_N71_D9_DATA_LEN];
+	int err;
+
+	/* Exactly one E7 prepare command, serialized by caller's report_lock. */
+	memset(z2->tx_buf, 0, 16);
+	memset(z2->rx_buf, 0, 16);
+	z2->tx_buf[0] = APPLE_Z2_CMD_RUNTIME_READ_LONG;
+	z2->tx_buf[1] = APPLE_Z2_REPORT_SURFACE;
+	put_unaligned_le16(APPLE_Z2_N71_D9_DATA_LEN, z2->tx_buf + 3);
+	for (i = 0; i < 14; i++)
+		sum += z2->tx_buf[i];
+	put_unaligned_le16(sum, z2->tx_buf + 14);
+	xfer.len = 16;
+	err = spi_sync_transfer(z2->spidev, &xfer, 1);
+	if (err)
+		return err;
+
+	/* Exactly one fixed-size read exchange; never trust an RX length. */
+	memset(z2->tx_buf, mode == 2 ? 0xa5 : 0, APPLE_Z2_N71_D9_FRAME_LEN);
+	memset(z2->rx_buf, 0, APPLE_Z2_N71_D9_FRAME_LEN);
+	if (mode == 1) {
+		z2->tx_buf[0] = APPLE_Z2_CMD_RUNTIME_READ_LONG;
+		z2->tx_buf[1] = APPLE_Z2_REPORT_SURFACE;
+		z2->tx_buf[2] = 1;
+		put_unaligned_le16(APPLE_Z2_N71_D9_DATA_LEN, z2->tx_buf + 3);
+		sum = 0;
+		for (i = 0; i < APPLE_Z2_N71_D9_FRAME_LEN - 2; i++)
+			sum += z2->tx_buf[i];
+		put_unaligned_le16(sum, z2->tx_buf + APPLE_Z2_N71_D9_FRAME_LEN - 2);
+	}
+	xfer.len = APPLE_Z2_N71_D9_FRAME_LEN;
+	err = spi_sync_transfer(z2->spidev, &xfer, 1);
+	if (err)
+		return err;
+
+	z2->n71_d9_fetch_first = z2->rx_buf[0];
+	sum = 0;
+	for (i = 0; i < APPLE_Z2_N71_D9_FRAME_LEN - 2; i++)
+		sum += z2->rx_buf[i];
+	z2->n71_d9_fetch_checksum_ok = (u16)sum ==
+		get_unaligned_le16(z2->rx_buf + APPLE_Z2_N71_D9_FRAME_LEN - 2);
+	memcpy(descriptor, z2->rx_buf + 3, sizeof(descriptor));
+	z2->n71_d9_left = (s16)get_unaligned_le16(descriptor + 8);
+	z2->n71_d9_bottom = (s16)get_unaligned_le16(descriptor + 10);
+	z2->n71_d9_right = (s16)get_unaligned_le16(descriptor + 12);
+	z2->n71_d9_top = (s16)get_unaligned_le16(descriptor + 14);
+	z2->n71_d9_geometry_plausible =
+		z2->n71_d9_left < z2->n71_d9_right &&
+		z2->n71_d9_top < z2->n71_d9_bottom &&
+		(int)z2->n71_d9_right - z2->n71_d9_left <= 20000 &&
+		(int)z2->n71_d9_bottom - z2->n71_d9_top <= 20000;
+	return 0;
+}
+
+static ssize_t runtime_d9_fetch_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	u8 mode;
+	int err;
+
+	if (sysfs_streq(buf, "1"))
+		mode = 1;
+	else if (sysfs_streq(buf, "2"))
+		mode = 2;
+	else
+		return -EINVAL;
+	if (!apple_z2_n71_runtime_ready(z2))
+		return -EOPNOTSUPP;
+	mutex_lock(&z2->report_lock);
+	if (z2->n71_d9_fetch_attempted) {
+		err = -EALREADY;
+		goto unlock;
+	}
+	if (!z2->n71_wake_attempted || z2->n71_wake_rc ||
+	    z2->n71_d9_attempts != 2 || z2->n71_d9_rc ||
+	    z2->n71_d9_reply != APPLE_Z2_CMD_RUNTIME_REPORT_INFO ||
+	    z2->n71_d9_status || z2->n71_d9_size != APPLE_Z2_N71_D9_DATA_LEN ||
+	    !z2->n71_d9_checksum_ok) {
+		err = -EAGAIN;
+		goto unlock;
+	}
+	/* Arm the single-use gate before either SPI transaction. */
+	z2->n71_d9_fetch_attempted = true;
+	z2->n71_d9_fetch_mode = mode;
+	z2->n71_d9_fetch_rc = apple_z2_n71_fetch_d9(z2, mode);
+	err = z2->n71_d9_fetch_rc;
+unlock:
+	mutex_unlock(&z2->report_lock);
+	return err ? err : count;
+}
+
+static DEVICE_ATTR_WO(runtime_d9_fetch);
+
+/*
+ * Both Sandcastle Z2 firmware modes issue AF 0 after reading D9.
+ * This control is armed only when the previously selected D9 transport
+ * returned a plausible surface; it is never automatic and cannot retry.
+ */
+static ssize_t runtime_af_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	struct spi_transfer xfer = {
+		.len = 16,
+	};
+	unsigned int sum = 0;
+	unsigned int i;
+	int err;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!apple_z2_n71_runtime_ready(z2))
+		return -EOPNOTSUPP;
+	xfer.tx_buf = z2->tx_buf;
+	xfer.rx_buf = z2->rx_buf;
+	mutex_lock(&z2->report_lock);
+	if (z2->n71_af_attempted) {
+		err = -EALREADY;
+		goto unlock;
+	}
+	if (!z2->n71_d9_fetch_attempted || z2->n71_d9_fetch_rc ||
+	    !z2->n71_d9_geometry_plausible) {
+		err = -EAGAIN;
+		goto unlock;
+	}
+	z2->n71_af_attempted = true;
+	memset(z2->tx_buf, 0, 16);
+	memset(z2->rx_buf, 0, 16);
+	z2->tx_buf[0] = APPLE_Z2_CMD_RUNTIME_WRITE_SHORT;
+	z2->tx_buf[1] = APPLE_Z2_REPORT_ENABLE_AF;
+	z2->tx_buf[2] = 1;
+	put_unaligned_le16(APPLE_Z2_CMD_RUNTIME_WRITE_SHORT +
+		APPLE_Z2_REPORT_ENABLE_AF + 1, z2->tx_buf + 14);
+	err = spi_sync_transfer(z2->spidev, &xfer, 1);
+	if (err)
+		goto done;
+	/* Commit E1: exactly one final 16-byte command. */
+	memset(z2->tx_buf, 0, 16);
+	memset(z2->rx_buf, 0, 16);
+	z2->tx_buf[0] = APPLE_Z2_CMD_RUNTIME_LAST;
+	put_unaligned_le16(APPLE_Z2_CMD_RUNTIME_LAST, z2->tx_buf + 14);
+	err = spi_sync_transfer(z2->spidev, &xfer, 1);
+	if (!err) {
+		z2->n71_af_reply = z2->rx_buf[0];
+		for (i = 0; i < 14; i++)
+			sum += z2->rx_buf[i];
+		z2->n71_af_checksum_ok = (u16)sum ==
+			get_unaligned_le16(z2->rx_buf + 14);
+	}
+done:
+	z2->n71_af_rc = err;
+unlock:
+	mutex_unlock(&z2->report_lock);
+	return err ? err : count;
+}
+
+static DEVICE_ATTR_WO(runtime_af);
