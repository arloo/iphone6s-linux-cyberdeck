diff --git a/drivers/pci/controller/Kconfig b/drivers/pci/controller/Kconfig
index d246bbe37..43076fbe6 100644
--- a/drivers/pci/controller/Kconfig
+++ b/drivers/pci/controller/Kconfig
@@ -54,6 +54,18 @@ config PCIE_APPLE
 
 	  If unsure, say Y if you have an Apple Silicon system.
 
+config PCIE_APPLE_S8000_RESEARCH_GUARD
+	tristate "Offline-only Apple A9 S8000 PCIe isolation guard"
+	depends on ARCH_APPLE && OF
+	default n
+	help
+	  Build an explicit fail-closed research guard for the Samsung A9
+	  S8000/N71 board. This is NOT a PCIe host controller implementation.
+	  It does not map MMIO, access clocks or reset lines, create a DMA
+	  mapping, register a PCI host, or enumerate the Wi-Fi controller.
+	  Even an explicitly matching synthetic DT node returns -EOPNOTSUPP.
+	  Leave disabled for all production and RAM boot images.
+
 config PCI_VERSATILE
 	bool "ARM Versatile PB PCI controller"
 	depends on ARCH_VERSATILE || COMPILE_TEST
