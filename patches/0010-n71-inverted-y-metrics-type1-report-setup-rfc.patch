 static DEVICE_ATTR_WO(runtime_d9_fetch);
 
 /*
+ * Sandcastle Type-1 setup: short report 9D=01 00... (8 bytes),
+ * short report BF=9D 81 09 00, then AF=00. Do not emit any of these
+ * automatically. This helper performs one E4 write and one E1 commit.
+ * Caller holds report_lock and has already validated the N71 descriptor.
+ */
+static int apple_z2_n71_write_short_locked(struct apple_z2 *z2, u8 id,
+					   const u8 *data, size_t size,
+					   u8 *last_reply)
+{
+	struct spi_transfer xfer = {
+		.tx_buf = z2->tx_buf,
+		.rx_buf = z2->rx_buf,
+		.len = 16,
+	};
+	unsigned int sum = 0, i;
+	int err;
+
+	if (!size || size > 11)
+		return -EINVAL;
+	memset(z2->tx_buf, 0, 16);
+	memset(z2->rx_buf, 0, 16);
+	z2->tx_buf[0] = APPLE_Z2_CMD_RUNTIME_WRITE_SHORT;
+	z2->tx_buf[1] = id;
+	z2->tx_buf[2] = size;
+	memcpy(z2->tx_buf + 3, data, size);
+	for (i = 0; i < 14; i++)
+		sum += z2->tx_buf[i];
+	put_unaligned_le16(sum, z2->tx_buf + 14);
+	err = spi_sync_transfer(z2->spidev, &xfer, 1);
+	if (err)
+		return err;
+
+	memset(z2->tx_buf, 0, 16);
+	memset(z2->rx_buf, 0, 16);
+	z2->tx_buf[0] = APPLE_Z2_CMD_RUNTIME_LAST;
+	put_unaligned_le16(APPLE_Z2_CMD_RUNTIME_LAST, z2->tx_buf + 14);
+	err = spi_sync_transfer(z2->spidev, &xfer, 1);
+	if (!err)
+		*last_reply = z2->rx_buf[0];
+	return err;
+}
+
+static ssize_t runtime_type1_setup_store(struct device *dev,
+					 struct device_attribute *attr,
+					 const char *buf, size_t count)
+{
+	static const u8 type1_9d[8] = { 1, 0, 0, 0, 0, 0, 0, 0 };
+	static const u8 type1_bf[4] = { 0x9d, 0x81, 0x09, 0x00 };
+	struct apple_z2 *z2 = dev_get_drvdata(dev);
+	int err;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!apple_z2_n71_runtime_ready(z2))
+		return -EOPNOTSUPP;
+	mutex_lock(&z2->report_lock);
+	if (z2->n71_type1_attempted) {
+		err = -EALREADY;
+		goto unlock;
+	}
+	if (!z2->n71_d9_fetch_attempted || z2->n71_d9_fetch_rc ||
+	    z2->n71_d9_fetch_mode != 1 ||
+	    !z2->n71_d9_geometry_plausible) {
+		err = -EAGAIN;
+		goto unlock;
+	}
+	/* One 9D+commit and one BF+commit, no retry on SPI failure. */
+	z2->n71_type1_attempted = true;
+	err = apple_z2_n71_write_short_locked(z2,
+		APPLE_Z2_REPORT_TYPE1_9D, type1_9d, sizeof(type1_9d),
+		&z2->n71_type1_last_reply);
+	if (!err)
+		err = apple_z2_n71_write_short_locked(z2,
+			APPLE_Z2_REPORT_TYPE1_BF, type1_bf, sizeof(type1_bf),
+			&z2->n71_type1_last_reply);
+	z2->n71_type1_rc = err;
+unlock:
+	mutex_unlock(&z2->report_lock);
+	return err ? err : count;
+}
+
+static DEVICE_ATTR_WO(runtime_type1_setup);
