 	dev_dbg(dev, "%s: payload %zu, sum 0x%08x, swap %d\n", what, len, sum,
 		hbpp_cal_swap);
+	if (hbpp_cal_nop) {
+		struct device_node *root = of_find_node_by_path("/");
+		bool is_s8000 = false;
+
+		if (root) {
+			is_s8000 = of_device_is_compatible(root, "apple,s8000");
+			of_node_put(root);
+		}
+		/* Fail closed outside the live-tested S8000 board/profile/size.
+		 * Buffer reserves a second padded payload; a 2-byte NOP fits.
+		 */
+		if (!is_s8000 || !z2->variant || !z2->variant->hbpp ||
+		    len != 1024 || padded != 1024 || pkt_len != 1038 ||
+		    address != 0x10009000)
+			return -EINVAL;
+		memmove(pkt + 2, pkt, pkt_len);
+		put_unaligned_be16(APPLE_Z2_HBPP_NOP, pkt);
+		pkt_len += 2;
+		dev_info(dev, "N71 calibration NOP frame: 1040 bytes; payload redacted\n");
+	}
 	error = apple_z2_hbpp_xfer(z2, pkt, NULL, pkt_len, what);
