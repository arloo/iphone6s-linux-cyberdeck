diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
--- a/drivers/input/touchscreen/apple_z2.c
+++ b/drivers/input/touchscreen/apple_z2.c
@@ -70,12 +70,22 @@
  * the word e59ff018), so the calibration bytes are byte swapped per 16-bit
  * word to land in memory in ADT order. Clear this to send them unswapped.
  */
 static bool hbpp_cal_swap = true;
 module_param(hbpp_cal_swap, bool, 0644);
 MODULE_PARM_DESC(hbpp_cal_swap, "Swap calibration bytes per 16-bit word (default on)");
+
+/* Single-variable HBPP framing hypothesis, intentionally DISABLED by default.
+ * The original N71 firmware DATA images begin with one NOP word; the
+ * synthesized calibration DATA packet currently does not. This option
+ * adds that word outside the payload/length/checksums for one controlled
+ * experiment. It is NOT evidence of an accepted calibration or working touch.
+ */
+static bool hbpp_cal_nop;
+module_param(hbpp_cal_nop, bool, 0444);
+MODULE_PARM_DESC(hbpp_cal_nop, "Experimental N71 calibration DATA NOP prefix (default off)");
 
 struct apple_z2_reg {
 	u32 addr;
 	u32 val;
 };
 
@@ -620,12 +630,32 @@
 	apple_z2_put_hbpp32(pkt + APPLE_Z2_HBPP_DATA_HDR_LEN + padded, sum);
 
 	snprintf(what, sizeof(what), "calibration %zu bytes to 0x%08x", pkt_len,
