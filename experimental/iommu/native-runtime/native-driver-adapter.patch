-
-	return res && res->start <= 0x60200bfffULL &&
-	       res->end >= 0x602008000ULL;
-}
-
+    struct resource *r=platform_get_resource(pdev,IORESOURCE_MEM,0);
+    return !n71_runtime_owner_ok() || strcmp(pdev->name,"n71-native-dart-provider") ||
+      !r || r->start!=0x602008000ULL || resource_size(r)!=0x4000;
+}
+
+static const struct apple_dart_hw apple_dart_hw_s5l8960x;
