+	ret = 0; /* No hardware IRQ in reset-held diagnostic. */
@@ -1714 +1678 @@
-	free_irq(dart->irq, dart);
+	if (dart->irq >= 0) free_irq(dart->irq, dart);
@@ -1728 +1692 @@
-	free_irq(dart->irq, dart);
+	if (dart->irq >= 0) free_irq(dart->irq, dart);
@@ -1923 +1887 @@
-MODULE_DEVICE_TABLE(of, apple_dart_of_match);
+
@@ -1927,2 +1891,2 @@
-		.name			= "apple-dart",
