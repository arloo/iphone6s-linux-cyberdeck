+		.name			= "n71-native-dart-provider",
+		.of_match_table		= NULL,
@@ -1930 +1894 @@
-		.pm			= pm_sleep_ptr(&apple_dart_pm_ops),
+		.pm			= NULL,
@@ -1936 +1900,2 @@
-module_platform_driver(apple_dart_driver);
