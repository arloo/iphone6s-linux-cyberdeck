CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_NO_EAP=y
CONFIG_IEEE80211W=y
CONFIG_NO_CONFIG_WRITE=y
CC=aarch64-linux-gnu-gcc
CFLAGS += -Os -I$(N71_ARM64_PREFIX)/include/libnl3
LDFLAGS += -static -L$(N71_ARM64_PREFIX)/lib
