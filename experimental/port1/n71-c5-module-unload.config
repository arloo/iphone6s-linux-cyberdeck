# SPDX-License-Identifier: MIT
# Minimal N71/S8000 RAM-only module lifecycle delta.
# Preserve the owner-validated touch/USB/BCM4350 software baseline.
# This fragment must NOT activate PCIe, PHY, DART1, DMA or Wi-Fi RF.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_FORCE_UNLOAD is not set
# CONFIG_MODULE_UNLOAD_TAINT_TRACKING is not set
