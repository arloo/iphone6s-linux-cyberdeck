Subject: [EXPERIMENTAL OFFLINE PATCH] iommu: apple-dart: Validate legacy DMA window and isolate packed TCR lock

Source baseline: previously reviewed N71 S5L8960X packed-TCR and five-cell DMA-window tree.
Origin: OrchardLinux/orchard S5L8960X DMA-window alignment patch 0005,
        contributed by Berkay Kösebay and Henrik Klee, adapted here.
Reference: https://github.com/OrchardLinux/orchard/blob/main/kernel/patches/drivers/iommu/0005-iommu-apple-dart-Refuse-S5L8960X-DMA-windows-that-ar.patch
The separate packed TCR lock is an isolated adaptation of Orchard patch 0007.
Scope: offline AArch64 compilation, not physically tested on DART1.
No new PCIe root or DART node, no real DMA or NAND operation.
---
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -205,10 +205,12 @@
 	int irq;
 	struct clk_bulk_data *clks;
 	int num_clks;
 
 	spinlock_t lock;
+	/* S5L8960X packed stream TCR byte bank, independent of command lock. */
+	spinlock_t tcr_lock;
 
 	u32 ias;
 	u32 oas;
 	u32 pgsize;
 	u32 num_streams;
@@ -377,16 +379,17 @@
 		return;
 
 	shift = sid * DART_S5L8960X_TCR_BITS_PER_STREAM;
 	mask = 0xffU << shift;
 
-	/* Four streams share one register; preserve all other stream fields. */
-	spin_lock_irqsave(&dart->lock, flags);
+	/* Four streams share one register; preserve other stream bytes. */
+	/* Do not take command lock here: setup can already hold dart->lock. */
+	spin_lock_irqsave(&dart->tcr_lock, flags);
 	tcr = readl(dart->regs + dart->hw->tcr);
 	tcr = (tcr & ~mask) | ((val << shift) & mask);
 	writel(tcr, dart->regs + dart->hw->tcr);
-	spin_unlock_irqrestore(&dart->lock, flags);
+	spin_unlock_irqrestore(&dart->tcr_lock, flags);
 }
 
 static u32 apple_dart_t8020_read_tcr(struct apple_dart *dart, u32 sid)
 {
 	return readl(dart->regs + DART_TCR(dart, sid));
@@ -717,10 +720,25 @@
 
 	mutex_lock(&dart_domain->init_lock);
 
 	if (dart_domain->finalized)
 		goto done;
+
+	/*
+	 * S5L8960X DARTs see IOVAs relative to the window base: behind the A9
+	 * PCIe root complex, IOVA 0xbbffe000 of the window at 0x80000000
+	 * reaches the DART as 0x3bffe000. The tables are indexed the same way
+	 * by masking the base off below, which equals subtracting it only if
+	 * the base is aligned beyond the window size.
+	 */
+	if (dart->hw->type == DART_S5L8960X && cfg->dma_min &&
+	    cfg->dma_max - cfg->dma_min >= (cfg->dma_min & -cfg->dma_min)) {
+		dev_err(dart->dev, "DMA window %pad..%pad is not base-aligned\n",
+			&cfg->dma_min, &cfg->dma_max);
+		ret = -EINVAL;
+		goto done;
+	}
 
 	for (i = 0; i < MAX_DARTS_PER_DEVICE; ++i) {
 		dart_domain->stream_maps[i].dart = cfg->stream_maps[i].dart;
 		for (j = 0; j < BITS_TO_LONGS(dart->num_streams); j++)
 			atomic_long_set(&dart_domain->stream_maps[i].sidmap[j],
@@ -1348,10 +1366,11 @@
 		return -ENOMEM;
 
 	dart->dev = dev;
 	dart->hw = of_device_get_match_data(dev);
 	spin_lock_init(&dart->lock);
+	spin_lock_init(&dart->tcr_lock);
 
 	dart->regs = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
 	if (IS_ERR(dart->regs))
 		return PTR_ERR(dart->regs);
 
